{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--executable-path",
        "/usr/bin/chromium",
        "--viewport-size",
        "1280x800",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
