{
  "name": "hordes-of-the-fallen-sky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:desktop && node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && npm run build:desktop",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.playwright.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:local": "npm run test:e2e && npm run test:desktop",
    "test:e2e": "playwright test",
    "test:e2e:changed": "node scripts/e2e-review.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "dev:web": "vite --host 127.0.0.1",
    "start": "electron .",
    "build:desktop": "tsc -p tsconfig.desktop.json && node scripts/generate-icon.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:linux": "npm run package -- --platform=linux --arch=x64",
    "package:win": "npm run package -- --platform=win32 --arch=x64",
    "steam:prepare": "node scripts/prepare-steam.mjs",
    "test:desktop": "npm run build && playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "phaser": "^3.90.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.9.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "productName": "Hordes of the Fallen Sky",
  "description": "A nomadic civilization builder and mounted bullet heaven",
  "main": "dist-desktop/desktop/main.js"
}
