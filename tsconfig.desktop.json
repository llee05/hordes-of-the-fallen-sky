{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-desktop",
    "noEmit": false
  },
  "include": ["desktop", "src/shared"],
  "exclude": ["node_modules", "dist", "dist-desktop"]
}
